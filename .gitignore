# ---- dependencies / build output ----
node_modules/
dist/
lib/
.next/
*.tsbuildinfo
.pnpm-store/
.pnpm-cache/
# 根目录调试残留（pnpm store 测试缓存等），不入库。
/.data/

# ---- reference mirror (pulled by scripts/sync-reference.mjs, NEVER committed) ----
# Open-source releases must not expose the upstream source or demo assets.
reference/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Electron build artifacts ----
apps/desktop/release/
apps/desktop/out/
apps/desktop/dist/
# P1-0 dist 构建产物（插件 tarball / branding.json / cordis.patch.yml 拷贝）。
# build/ 里默认品牌的 icon.ico/png 随仓库提交（默认图标资源），不 ignore；
# 只有 dist 按品牌生成的卸载 nsh 忽略。
apps/desktop/resources/
apps/desktop/build/delete-appdata.generated.nsh

# ---- desktop spike data (dsh DSH_HOME: profiles, storages, session logs) ----
apps/desktop/.data/

# ---- local env / secrets ----
.env
.env.*
!.env.example

# ---- AI 规范目录桥（Windows junction，本地经 scripts/setup-agent-links.ps1 重建，不入库） ----
# .claude/ 是正典（skills + notes + roles，已入库）。
# .agents/skills 是 dsh skill-filesystem 的 rank-200 项目技能发现根（上游契约路径，不可改名）；
# .trae/skills 供 Trae 读取；junction 无法跨平台提交，故整体忽略。
.agents/
.trae/

# ---- logs ----
*.log
/.vs

# ---- temporary patch-generation scratch (make_patch.py + orig/patched client.js) ----
.tmp-patch/
