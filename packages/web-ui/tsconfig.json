{
  // "paths" pins every "react" import in the program — including the upstream
  // .d.ts files this package consumes, whose own resolution can otherwise pick
  // up the React 19 types that coexist in this monorepo — to this package's
  // React 18 types, the version the official client runtime ships (D10).
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "paths": {
      "react": ["./node_modules/@types/react/index.d.ts"]
    }
  },
  "include": [
    "src"
  ]
}
