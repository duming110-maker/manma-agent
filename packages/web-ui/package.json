{
  "name": "@bc-agent/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "BC Agent Desktop client layout plugin: self-built shell frame occupying the runtime 'root' slot, declaring the sidebar/conversation/details/shell.overlay child seats (D1 spike)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.7",
    "@eslint/js": "^9.39.5",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "react": "^18.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  }
}
